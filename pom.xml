<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.sberbank.bigdata.dffess.ssd</groupId>
    <artifactId>vspc_idl</artifactId>
    <version>D-02.104.001</version>
    <packaging>jar</packaging>

    <name>vspc_idl</name>

    <parent>
        <groupId>ru.sberbank.bigdata.sl.rt</groupId>
        <artifactId>rt-fw-baseline</artifactId>
        <version>3.16.1</version>
    </parent>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>1.8</java.version>
        <spark.version>3.5.1</spark.version>
        <spark.scala.version>2.12</spark.scala.version>
        <SKClient.version>1.30.1</SKClient.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
    </properties>

    <repositories>
        <repository>
            <id>Nexus_CI_Release</id>
            <name>Nexus_Release</name>
            <url>https://nexus-ci.delta.sbrf.ru/repository/maven-lib-release</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>Nexus_CI_Snapshot</id>
            <name>Nexus_Snapshot</name>
            <url>https://nexus-ci.delta.sbrf.ru/repository/maven-lib-dev</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>

        <repository>
            <id>maven-distr-release</id>
            <name>public</name>
            <url>https://nexus-ci.delta.sbrf.ru/repository/maven-distr</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>maven-distr-dev</id>
            <name>maven-distr-dev</name>
            <url>https://nexus-ci.delta.sbrf.ru/repository/maven-distr-dev</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>nexus-ci</id>
            <name>nexus-ci</name>
            <url>https://nexus-ci.delta.sbrf.ru/repository/public</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${spark.scala.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ru.sberbank.bigdata.sl.sk</groupId>
            <artifactId>sl-sk-client</artifactId>
            <version>${SKClient.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.hbase</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-hdfs</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-lang3</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <!-- vspc-3.0 parity: классы замещены shadow-копиями из src/main/java/ru/sberbank/bigdata/sl/rt/publisher/strategy/{process/changes,publish,prepare,process}/ — см. temp/audit_default_publisher_fixmap.md, temp/accepted_risks_registry.md, temp/audit_v2/23_rewrite_scope_fix_research.md, temp/ctl_validfrom_contract/F_impl_report.md -->
                                <filter>
                                    <artifact>ru.sberbank.bigdata.sl.rt:rt-fw-publisher</artifact>
                                    <excludes>
                                        <!-- 5 классов заменяются shadow-копиями из
                                             src/main/java/ru/sberbank/bigdata/sl/rt/publisher/strategy/{process/changes,publish,prepare,process}/,
                                             восстанавливающими поведение 3.0. Исключение обязательно: иначе в fat-jar
                                             окажутся две копии класса, и какая из них выиграет — зависит от порядка
                                             артефактов в shade. Проверено сборкой: в fat-jar ровно одна копия каждого
                                             из 5 классов, совпадающая побайтно с target/classes, и 0 дублей .class.
                                             У PreparationStage/ProcessingStage внутренних классов нет
                                             (в rt-fw-publisher:2.16.1 их нет) — $-варианты исключены на всякий случай.
                                             Обоснование правок — в temp/audit_default_publisher_fixmap.md,
                                             temp/accepted_risks_registry.md, temp/audit_v2/23_rewrite_scope_fix_research.md,
                                             temp/ctl_validfrom_contract/F_impl_report.md (каталог temp/ не в git:
                                             ссылки действуют только в рабочем дереве). -->
                                        <exclude>ru/sberbank/bigdata/sl/rt/publisher/strategy/process/changes/HistoricalPeriodWithRewriteChangesCalculator.class</exclude>
                                        <exclude>ru/sberbank/bigdata/sl/rt/publisher/strategy/process/changes/NonHistoricalChangesCalculator.class</exclude>
                                        <exclude>ru/sberbank/bigdata/sl/rt/publisher/strategy/publish/PublicationStage.class</exclude>
                                        <!-- Контракт ctl_validfrom: shadow-пара strategy/{prepare,process} (drop не стирает принесённый ctl_validfrom; enrichTechFieldsForInit = fill-if-absent). $-вариантов нет (проверено), исключены на всякий случай -->
                                        <exclude>ru/sberbank/bigdata/sl/rt/publisher/strategy/prepare/PreparationStage.class</exclude>
                                        <exclude>ru/sberbank/bigdata/sl/rt/publisher/strategy/prepare/PreparationStage$*.class</exclude>
                                        <exclude>ru/sberbank/bigdata/sl/rt/publisher/strategy/process/ProcessingStage.class</exclude>
                                        <exclude>ru/sberbank/bigdata/sl/rt/publisher/strategy/process/ProcessingStage$*.class</exclude>
                                    </excludes>
                                </filter>
                                <!-- X2-N1: junit-транзитивы leak'нули в fat-jar из rt-fw-coordinator-3.16.0 (junit-jupiter-engine) и rt-fw-logger-2.20.0 (junit-platform-engine/junit-jupiter-api) без <scope>test</scope>; в рантайме не используются (никто из удерживаемых классов на них не ссылается). Резать только junit-семейство: reflections/javassist (rt/core/App, JavassistHelper), commons-jexl3 (MacrosCrossValidator), super-csv (coordinator CtlLogAgent/CtlCsvUtils/RecoverHelper), maven-artifact/plexus-utils (sk CommonServiceUtil) — используемы, НЕ вырезать. CR к RT-FW про потерянный scope — отдельно. -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>org/junit/**</exclude>
                                        <exclude>org/opentest4j/**</exclude>
                                        <exclude>org/apiguardian/**</exclude>
                                        <exclude>META-INF/versions/*/org/junit/**</exclude>
                                        <exclude>META-INF/versions/*/org/opentest4j/**</exclude>
                                        <exclude>META-INF/versions/*/org/apiguardian/**</exclude>
                                        <exclude>META-INF/services/org.junit.platform.engine.TestEngine</exclude>
                                        <exclude>META-INF/junit-jupiter-api.kotlin_module</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Подписи зависимостей после шейдинга невалидны: оставленные в jar
                                             подписи делают его нечитаемым (SecurityException на этапе загрузки
                                             подписанного jar-а). -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Имя собираемого артефакта — контракт с vars_all.yml: devops_distributive_jar =
                                 "vspc_idl-{{ build_version }}-jar-with-dependencies.jar", где build_version = D-02.104.001
                                 совпадает с <version> этого pom. Сборка: mvn clean package -DskipTests. -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>jar-with-dependencies</shadedClassifierName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>