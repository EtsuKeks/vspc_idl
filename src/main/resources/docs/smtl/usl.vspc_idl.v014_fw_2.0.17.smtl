schema("usl_vspc_idl_in_snp").select();

target("addr", "", rows(table("ebx_rep_m_sfs_0002_sfsdivision")),historyNone(), staticWhere("1=1"))
	.mapping("@cntry", get("[cntry_code]"))
	.mapping("@okato2", get("[address_addrfact_okatocode]"))
	.mapping("@rus_fed_subj", get("[addres_normal_subject_code]"))
	.mapping("city_name", get("[address_addrfact_addrcity_cityname]"))
	.mapping("district_name", get("[address_addrfact_addrarea_areaname]"))
	.mapping("fias_code", get("[address_addrfact_fiascode]"))
	.mapping("house_num", get("[address_addrfact_addrhouse_housenumbers]"))
	.mapping("idx_num", get("[address_addrfact_postcode]"))
	.mapping("locty_name", get("[address_addrfact_addrplace_placename]"))
	.mapping("reg_addr_name", get("[address_subjectcode]"))
	.mapping("src_txt", get("[address_locationaddress]"))
	.mapping("street_name", get("[address_addrfact_addrstreet_streetname]"))
	.mapping("standard_addr_txt", get("[address_locationaddress]"));


target("div", "", rows(table("ebx_rep_m_sfs_0002_sfsdivision")),historyNone(), staticWhere("1=1"))
	.mapping("code", get("[fulldivcode]"))
	.mapping("div_close_dt", get("[closedate]"))
	.mapping("div_open_dt", get("[opendate]"))
	.mapping("legal@addr", get("[address_legaladdrdoc]"))
	.mapping("parent@div", get("[headdivisioncode]"))
	.mapping("div_time_zone@time_zone_rf", get("[address_addrfact_timezone]"))
	.mapping("full_reg_num", get("[address_addrfact_timezone]"))
	.mapping("reg_ord", get("[requisitesdivision_registrationnum]"))
	.mapping("short_div_code", get("[addr_building_num]"))
	.mapping("subbranch_code", get("[addr_building_num]"))
	.mapping("div_name", get("[addr_building_num]"))
	.mapping("fact@addr", get("[addr_building_num]"))
	.mapping("div_type@terr_div_type", get("[addr_building_num]"))
	.mapping("@pay_sys_prtcpnt", get("[as_house_types_sk]"));


target("terr_div_type", "", rows(table("ebx_rep_m_sfs_0002_sfsdivision")),historyNone(), staticWhere("1=1"))
	.mapping("div_type_code", get("[addr_placement_num]"));

target("time_zone_rf", "", rows(table("ebx_rep_m_sfs_0002_sfsdivision")),historyNone(), staticWhere("1=1"))
	.mapping("time_zone_abbr_code", get("[addr_place_addr_sk]"))
	.mapping("time_zone_code", get("[addr_place_access_for_disable_flag]"))
	.mapping("time_zone_msk_shift_val", get("[addr_place_name]"))
	.mapping("time_zone_name", get("[addr_place_stock_flag]"))
	.mapping("time_zone_wrld_shift_val", get("[addr_place_div_flag]"));