<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>central</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>
        <server>
            <id>public</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>

        <server>
            <id>Nexus_CI_Snapshot</id>
            <username>${user.nexus3}</username>
            <password>${password}</password>
        </server>
        <server>
            <id>Nexus_CI_Release</id>
            <username>${user.nexus3}</username>
            <password>${password}</password>
        </server>

        <server>
            <id>maven-distr-dev</id>
            <username>${user.nexus3}</username>
            <password>${password}</password>
        </server>
        <server>
            <id>maven-distr-release</id>
            <username>${user.nexus3}</username>
            <password>${password}</password>
        </server>

        <server>
            <id>Bigdata_snapshot</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>
        <server>
            <id>Bigdata_release</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>

        <server>
            <id>repository.jboss.test</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>
        <server>
            <id>dynamodb-local-oregon.test</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>
        <server>
            <id>apache.snapshots.test</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>
        <server>
            <id>apache.snapshots.https.test</id>
            <username>${user}</username>
            <password>${password}</password>
        </server>
    </servers>

    <mirrors>
        <mirror>
            <id>central</id>
            <name>central</name>
            <url>https://sbtnexus.delta.sbrf.ru/nexus/content/repositories/central/</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
        <mirror>
            <id>repository.jboss.test</id>
            <name>Delta Nexus</name>
            <url>https://sbtnexus.delta.sbrf.ru/nexus/content/repositories/central/</url>
            <mirrorOf>repository.jboss.org</mirrorOf>
        </mirror>
        <mirror>
            <id>dynamodb-local-oregon.test</id>
            <name>Delta Nexus</name>
            <url>https://sbtnexus.delta.sbrf.ru/nexus/content/repositories/central/</url>
            <mirrorOf>dynamodb-local-oregon</mirrorOf>
        </mirror>
        <mirror>
            <id>apache.snapshots.test</id>
            <name>Delta Nexus</name>
            <url>https://sbtnexus.delta.sbrf.ru/nexus/content/repositories/central/</url>
            <mirrorOf>apache.snapshots</mirrorOf>
        </mirror>
        <mirror>
            <id>apache.snapshots.https.test</id>
            <name>Delta Nexus</name>
            <url>https://sbtnexus.delta.sbrf.ru/nexus/content/repositories/central/</url>
            <mirrorOf>apache.snapshots.https</mirrorOf>
        </mirror>
    </mirrors>

</settings>