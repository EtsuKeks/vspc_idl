<workflow-app name="{{ logical_env_prefix }}usl.usl_rtfw_ndl_eks" xmlns="uri:oozie:workflow:0.5">
    <global>
        <configuration>
            <property>
                <name>mapred.job.queue.name</name>
                <value>${yarn_queue}</value>
            </property>
        </configuration>
    </global>

    <start to="MAIN_ACTION"/>

    <action name="MAIN_ACTION"  cred='howlauth'>
        <shell xmlns="uri:oozie:shell-action:0.1">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <exec>StartLauncher.sh</exec>
            <argument>${loading_id}</argument> <!-- 1 -->
            <argument>${wf:conf('user.name')}@${kerberos_realm}</argument> <!-- 2 -->
            <argument>${ctl_secure}</argument> <!-- 3 -->
            <argument>${user_keytab_path}${wf:conf('user.name')}.keytab</argument> <!-- 4 -->
            <argument>${devops_distributive_jar}</argument> <!-- 5 -->
            <argument>${yarn_queue}</argument> <!-- 6 -->

            <file>StartLauncher.sh#StartLauncher.sh</file>
            <file>lib/${devops_distributive_jar}#${devops_distributive_jar}</file>
        </shell>
        <ok to="End"/>
        <error to="KILL_ERROR"/>
    </action>

    <kill name="KILL_ERROR">
        <message>Action failed, error message[${wf:errorMessage(wf:lastErrorNode())}]</message>
    </kill>

    <end name="End"/>

</workflow-app>